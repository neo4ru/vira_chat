<div class="flex h-screen bg-gray-100">
  <!-- Sidebar -->
  <div class="w-80 bg-white border-r border-gray-200 flex flex-col">
    <div class="p-4 border-b border-gray-200 flex justify-between items-center">
      <h1 class="text-xl font-bold text-gray-800">ViraChat</h1>
      <button phx-click="toggle_new_chat" class="text-blue-600 hover:text-blue-800 text-2xl font-bold">+</button>
    </div>

    <!-- New chat panel -->
    <%= if @show_new_chat do %>
      <div class="p-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-sm font-semibold text-gray-600 mb-2">Start a new chat</h2>
        <div class="space-y-1 max-h-40 overflow-y-auto">
          <%= for user <- @users do %>
            <button
              phx-click="start_chat"
              phx-value-user_id={user.id}
              class="w-full text-left px-3 py-2 rounded hover:bg-blue-50 text-sm"
            >
              <%= user.email %>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Conversation list -->
    <div class="flex-1 overflow-y-auto">
      <%= for conversation <- @conversations do %>
        <.link
          patch={~p"/chat/#{conversation.id}"}
          class={"block px-4 py-3 border-b border-gray-100 hover:bg-gray-50 #{if @active_conversation && @active_conversation.id == conversation.id, do: "bg-blue-50", else: ""}"}
        >
          <div class="font-medium text-gray-800">
            <%= conversation_title(conversation, @current_user) %>
          </div>
        </.link>
      <% end %>
    </div>

    <!-- User info -->
    <div class="p-4 border-t border-gray-200 flex justify-between items-center">
      <span class="text-sm text-gray-600 truncate"><%= @current_user.email %></span>
      <.link href={~p"/users/log_out"} method="delete" class="text-sm text-red-600 hover:underline">
        Log out
      </.link>
    </div>
  </div>

  <!-- Main chat area -->
  <div class="flex-1 flex flex-col">
    <%= if @active_conversation do %>
      <!-- Header -->
      <div class="p-4 bg-white border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-800">
          <%= conversation_title(@active_conversation, @current_user) %>
        </h2>
      </div>

      <!-- Messages -->
      <div id="messages" phx-hook="ScrollToBottom" class="flex-1 overflow-y-auto p-4 space-y-3">
        <%= for message <- @messages do %>
          <div class={"flex #{if message.user_id == @current_user.id, do: "justify-end", else: "justify-start"}"}>
            <div class={"max-w-xs lg:max-w-md px-4 py-2 rounded-lg #{if message.user_id == @current_user.id, do: "bg-blue-500 text-white", else: "bg-white text-gray-800 border border-gray-200"}"}>
              <div class="text-xs font-semibold mb-1 opacity-75">
                <%= message.user.email %>
              </div>
              <div><%= message.content %></div>
              <div class="text-xs mt-1 opacity-60">
                <%= Calendar.strftime(message.inserted_at, "%H:%M") %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Message input -->
      <div class="p-4 bg-white border-t border-gray-200">
        <.form for={@message_form} phx-submit="send_message" class="flex gap-2">
          <input
            type="text"
            name="content"
            value={@message_form[:content].value}
            placeholder="Type a message..."
            autocomplete="off"
            class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          <button
            type="submit"
            class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium"
          >
            Send
          </button>
        </.form>
      </div>
    <% else %>
      <div class="flex-1 flex items-center justify-center text-gray-400">
        <div class="text-center">
          <p class="text-2xl mb-2">💬</p>
          <p>Select a conversation or start a new one</p>
        </div>
      </div>
    <% end %>
  </div>
</div>