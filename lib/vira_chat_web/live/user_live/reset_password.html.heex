<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.auth_shell
    title={if @live_action == :new, do: "Reset your password", else: "Choose a new password"}
    subtitle={
      if @live_action == :new,
        do: "We'll email you a link to reset it.",
        else: "Pick a password with at least 12 characters."
    }
  >
    <div class="rounded-2xl border border-line bg-white p-5 shadow-sm dark:border-[#242424] dark:bg-[#141414]">
      <%= if @live_action == :new do %>
        <.form
          for={@form}
          id="reset_password_form"
          phx-submit="submit"
          phx-change="validate_email"
          class="space-y-4"
        >
          <div>
            <label
              for={@form[:email].id}
              class="mb-1.5 block text-[12px] font-semibold text-ink dark:text-white"
            >
              Email
            </label>
            <input
              type="email"
              name={@form[:email].name}
              id={@form[:email].id}
              value={@form[:email].value}
              autocomplete="username"
              spellcheck="false"
              required
              placeholder="you@example.com"
              class="w-full rounded-xl border border-line bg-surface-2 px-3.5 py-2.5 text-[13px] text-ink outline-none transition placeholder:text-muted focus:border-brand/40 focus:bg-white focus:ring-2 focus:ring-brand/15 dark:border-[#2a2a2a] dark:bg-[#161616] dark:text-white dark:focus:bg-[#111]"
            />
          </div>
          <button
            type="submit"
            phx-disable-with="Sending..."
            class="w-full rounded-xl bg-brand px-4 py-2.5 text-[13px] font-semibold text-white shadow-sm shadow-brand/30 transition hover:bg-brand-600 disabled:opacity-50"
          >
            Send reset link
          </button>
        </.form>
      <% else %>
        <.form
          for={@form}
          id="reset_password_form"
          phx-submit="save"
          phx-change="validate_password"
          class="space-y-4"
        >
          <div>
            <label
              for={@form[:password].id}
              class="mb-1.5 block text-[12px] font-semibold text-ink dark:text-white"
            >
              New password
            </label>
            <input
              type="password"
              name={@form[:password].name}
              id={@form[:password].id}
              autocomplete="new-password"
              spellcheck="false"
              required
              class="w-full rounded-xl border border-line bg-surface-2 px-3.5 py-2.5 text-[13px] text-ink outline-none transition focus:border-brand/40 focus:bg-white focus:ring-2 focus:ring-brand/15 dark:border-[#2a2a2a] dark:bg-[#161616] dark:text-white dark:focus:bg-[#111]"
            />
            <%= for {message, _opts} <- @form[:password].errors do %>
              <p class="mt-1 text-[11px] font-medium text-danger">{message}</p>
            <% end %>
          </div>

          <div>
            <label
              for={@form[:password_confirmation].id}
              class="mb-1.5 block text-[12px] font-semibold text-ink dark:text-white"
            >
              Confirm new password
            </label>
            <input
              type="password"
              name={@form[:password_confirmation].name}
              id={@form[:password_confirmation].id}
              autocomplete="new-password"
              spellcheck="false"
              class="w-full rounded-xl border border-line bg-surface-2 px-3.5 py-2.5 text-[13px] text-ink outline-none transition focus:border-brand/40 focus:bg-white focus:ring-2 focus:ring-brand/15 dark:border-[#2a2a2a] dark:bg-[#161616] dark:text-white dark:focus:bg-[#111]"
            />
            <%= for {message, _opts} <- @form[:password_confirmation].errors do %>
              <p class="mt-1 text-[11px] font-medium text-danger">{message}</p>
            <% end %>
          </div>

          <button
            type="submit"
            phx-disable-with="Saving..."
            class="w-full rounded-xl bg-brand px-4 py-2.5 text-[13px] font-semibold text-white shadow-sm shadow-brand/30 transition hover:bg-brand-600 disabled:opacity-50"
          >
            Save password
          </button>
        </.form>
      <% end %>
    </div>

    <p class="mt-5 text-center text-[12.5px] text-body">
      <.link navigate={~p"/users/log-in"} class="font-semibold text-brand hover:underline">
        Back to log in
      </.link>
    </p>
  </.auth_shell>
</Layouts.app>
