<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-50 via-white to-blue-50 px-4 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <.link navigate={~p"/"} class="inline-flex items-center gap-2">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white font-bold text-xl">V</div>
        <span class="text-2xl font-bold text-gray-900">ViraChat</span>
      </.link>
      <h1 class="text-2xl font-bold text-gray-900 mt-6">Create your account</h1>
      <p class="text-gray-500 text-sm mt-1">Start chatting in under a minute</p>
    </div>

    <div class="bg-white rounded-2xl shadow-xl shadow-slate-900/5 border border-gray-100 p-8">
      <.flash_group flash={@flash} />

      <.form for={@form} id="registration_form" phx-submit="save" phx-change="validate">
        <div class="space-y-4">
          <div>
            <label for={@form[:email].id} class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input
              type="email"
              name={@form[:email].name}
              id={@form[:email].id}
              value={@form[:email].value}
              required
              autofocus
              autocomplete="username"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="you@example.com"
            />
            <p :if={@form[:email].errors} class="mt-1 text-xs text-red-600">
              <%= translate_errors(@form[:email].errors) %>
            </p>
          </div>

          <div>
            <label for={@form[:password].id} class="block text-sm font-medium text-gray-700 mb-1">Password</label>
            <input
              type="password"
              name={@form[:password].name}
              id={@form[:password].id}
              value={@form[:password].value}
              required
              autocomplete="new-password"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              placeholder="At least 12 characters"
            />
            <p class="text-xs text-gray-500 mt-1">Minimum 12 characters. Longer is better.</p>
            <p :if={@form[:password].errors} class="mt-1 text-xs text-red-600">
              <%= translate_errors(@form[:password].errors) %>
            </p>
          </div>
        </div>

        <button type="submit" class="mt-6 w-full py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-semibold transition">
          Create account
        </button>
      </.form>

      <p class="text-xs text-gray-500 text-center mt-4">
        By creating an account you agree to our Terms and Privacy Policy.
      </p>
    </div>

    <p class="text-center text-sm text-gray-500 mt-6">
      Already have an account?
      <.link navigate={~p"/users/log-in"} class="text-blue-600 hover:underline font-medium">Log in</.link>
    </p>
  </div>
</div>