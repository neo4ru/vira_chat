<div class="min-h-screen bg-gradient-to-b from-slate-50 to-white">
  <!-- Nav -->
  <header class="border-b border-gray-100 bg-white/80 backdrop-blur sticky top-0 z-10">
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
      <div class="flex items-center gap-2">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white font-bold text-lg">V</div>
        <span class="text-xl font-bold text-gray-900">ViraChat</span>
      </div>
      <nav class="flex items-center gap-3">
        <%= if @current_scope && @current_scope.user do %>
          <.link navigate={~p"/chat"} class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium text-sm">
            Open chat →
          </.link>
        <% else %>
          <.link navigate={~p"/users/log-in"} class="px-4 py-2 text-gray-700 hover:text-gray-900 font-medium text-sm">
            Log in
          </.link>
          <.link navigate={~p"/users/register"} class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium text-sm">
            Sign up
          </.link>
        <% end %>
      </nav>
    </div>
  </header>

  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-20 text-center">
    <div class="inline-block px-3 py-1 bg-blue-50 text-blue-700 rounded-full text-xs font-semibold tracking-wide uppercase mb-6">
      Built with Elixir & Phoenix
    </div>
    <h1 class="text-5xl md:text-6xl font-extrabold text-gray-900 tracking-tight mb-6 leading-tight">
      Chat. Connect.<br/>
      <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">Belong.</span>
    </h1>
    <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto mb-10">
      Real-time conversations, group chats, presence, and file sharing.
      Fast, private, and built to scale.
    </p>
    <div class="flex justify-center gap-3">
      <%= if @current_scope && @current_scope.user do %>
        <.link navigate={~p"/chat"} class="px-8 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-semibold shadow-lg shadow-blue-500/20">
          Open ViraChat →
        </.link>
      <% else %>
        <.link navigate={~p"/users/register"} class="px-8 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-semibold shadow-lg shadow-blue-500/20">
          Get started — it's free
        </.link>
        <.link navigate={~p"/users/log-in"} class="px-8 py-3 bg-white border border-gray-300 text-gray-800 rounded-lg hover:bg-gray-50 font-semibold">
          I have an account
        </.link>
      <% end %>
    </div>
  </section>

  <!-- App preview -->
  <section class="max-w-5xl mx-auto px-6 pb-24">
    <div class="rounded-2xl shadow-2xl shadow-slate-900/10 border border-gray-200 overflow-hidden bg-white">
      <div class="flex items-center gap-2 px-4 py-3 bg-gray-50 border-b border-gray-200">
        <div class="w-3 h-3 rounded-full bg-red-400"></div>
        <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
        <div class="w-3 h-3 rounded-full bg-green-400"></div>
        <div class="ml-4 text-xs text-gray-500">virachat.app/chat</div>
      </div>
      <div class="grid grid-cols-3 h-[380px]">
        <div class="border-r border-gray-100 p-4 space-y-3">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-blue-500"></div>
            <div class="h-3 w-20 bg-gray-200 rounded"></div>
          </div>
          <div class="flex items-center gap-2 bg-blue-50 rounded-lg p-2">
            <div class="w-8 h-8 rounded-full bg-purple-500"></div>
            <div class="flex-1">
              <div class="h-3 w-24 bg-gray-300 rounded mb-1"></div>
              <div class="h-2 w-32 bg-gray-200 rounded"></div>
            </div>
            <div class="w-5 h-5 rounded-full bg-blue-600 text-white text-xs flex items-center justify-center font-bold">3</div>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-green-500"></div>
            <div class="h-3 w-20 bg-gray-200 rounded"></div>
          </div>
        </div>
        <div class="col-span-2 p-4 flex flex-col gap-3 bg-gray-50">
          <div class="flex justify-start">
            <div class="max-w-xs bg-white border border-gray-200 rounded-lg px-3 py-2">
              <div class="h-2 w-16 bg-gray-300 rounded mb-2"></div>
              <div class="h-2 w-40 bg-gray-200 rounded"></div>
            </div>
          </div>
          <div class="flex justify-end">
            <div class="max-w-xs bg-blue-500 rounded-lg px-3 py-2">
              <div class="h-2 w-40 bg-blue-300 rounded"></div>
            </div>
          </div>
          <div class="flex justify-start">
            <div class="max-w-xs bg-white border border-gray-200 rounded-lg px-3 py-2">
              <div class="h-2 w-32 bg-gray-200 rounded"></div>
            </div>
          </div>
          <div class="mt-auto flex gap-2">
            <div class="flex-1 h-10 bg-white border border-gray-200 rounded-lg"></div>
            <div class="w-20 h-10 bg-blue-600 rounded-lg"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="max-w-6xl mx-auto px-6 pb-24">
    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-4">Everything you need to stay connected</h2>
    <p class="text-gray-600 text-center mb-12 max-w-xl mx-auto">From one-on-one conversations to team group chats — ViraChat has the features modern messaging deserves.</p>

    <div class="grid md:grid-cols-3 gap-6">
      <%= for {icon, title, body} <- [
        {"⚡", "Real-time messaging", "Messages appear instantly across all devices. No refresh, no delay."},
        {"👥", "Group chats", "Bring your friends, family, or team together in one conversation."},
        {"🟢", "Presence & typing", "See who's online and when someone's typing a reply."},
        {"✓✓", "Read receipts", "Know exactly when your message has been seen."},
        {"📎", "File sharing", "Send images, documents, and more with a single tap."},
        {"🔒", "Private by default", "Your conversations stay yours. No ads, no tracking."}
      ] do %>
        <div class="p-6 bg-white rounded-xl border border-gray-200 hover:border-blue-300 hover:shadow-lg transition">
          <div class="text-3xl mb-3"><%= icon %></div>
          <h3 class="font-bold text-gray-900 mb-2"><%= title %></h3>
          <p class="text-sm text-gray-600 leading-relaxed"><%= body %></p>
        </div>
      <% end %>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-4xl mx-auto px-6 pb-24 text-center">
    <div class="p-12 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-700 text-white">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Ready to start chatting?</h2>
      <p class="text-blue-100 mb-8 max-w-lg mx-auto">Create your account in seconds. Free forever for personal use.</p>
      <%= if @current_scope && @current_scope.user do %>
        <.link navigate={~p"/chat"} class="inline-block px-8 py-3 bg-white text-blue-700 rounded-lg hover:bg-blue-50 font-semibold">
          Open ViraChat →
        </.link>
      <% else %>
        <.link navigate={~p"/users/register"} class="inline-block px-8 py-3 bg-white text-blue-700 rounded-lg hover:bg-blue-50 font-semibold">
          Create your account
        </.link>
      <% end %>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-gray-100 py-8 text-center text-sm text-gray-500">
    <p>© <%= DateTime.utc_now().year %> ViraChat · Built with Elixir & Phoenix</p>
  </footer>
</div>