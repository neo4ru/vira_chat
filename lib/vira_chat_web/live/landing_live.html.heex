<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="min-h-screen bg-white dark:bg-[#0b0b0d]">
    <header class="sticky top-0 z-30 border-b border-line/70 bg-white/85 backdrop-blur dark:border-[#242424] dark:bg-[#0d0d0d]/85">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3.5 sm:px-6">
        <a href="/" class="flex items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand text-sm font-extrabold text-white shadow-sm shadow-brand/30">
            V
          </span>
          <span class="text-[17px] font-bold tracking-tight text-ink dark:text-white">ViraChat</span>
        </a>

        <nav class="flex items-center gap-2">
          <%= if @current_scope && @current_scope.user do %>
            <.link
              navigate={~p"/chat"}
              class="flex items-center gap-2 rounded-xl bg-brand px-4 py-2.5 text-[12.5px] font-semibold text-white shadow-sm shadow-brand/30 transition hover:bg-brand-600"
            >
              Open chats <.icon name="hero-arrow-right" class="size-3.5" />
            </.link>
          <% else %>
            <.link
              navigate={~p"/users/log-in"}
              class="rounded-xl px-3.5 py-2.5 text-[12.5px] font-semibold text-body transition hover:text-ink dark:hover:text-white"
            >
              Log in
            </.link>
            <.link
              navigate={~p"/users/register"}
              class="rounded-xl bg-brand px-4 py-2.5 text-[12.5px] font-semibold text-white shadow-sm shadow-brand/30 transition hover:bg-brand-600"
            >
              Get started
            </.link>
          <% end %>
        </nav>
      </div>
    </header>

    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute -top-32 left-1/2 h-[420px] w-[820px] -translate-x-1/2 rounded-full bg-brand/10 blur-3xl">
      </div>

      <div class="relative mx-auto max-w-6xl px-5 pb-16 pt-14 text-center sm:px-6 sm:pt-20">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand/20 bg-brand-soft px-3 py-1 text-[10.5px] font-bold uppercase tracking-[0.12em] text-brand">
          <.icon name="hero-bolt" class="size-3.5" /> Built with Elixir &amp; Phoenix
        </span>

        <h1 class="mt-6 text-[40px] font-extrabold leading-[1.05] tracking-tight text-ink dark:text-white sm:text-[58px]">
          Chat. Connect.<br />
          <span class="bg-gradient-to-r from-brand via-[#8b5cf6] to-[#c084fc] bg-clip-text text-transparent">
            Belong.
          </span>
        </h1>

        <p class="mx-auto mt-5 max-w-xl text-[15px] leading-relaxed text-body sm:text-[16.5px]">
          Real-time conversations, group chats, presence, calls and file sharing — fast, private
          and built to scale.
        </p>

        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <%= if @current_scope && @current_scope.user do %>
            <.link
              navigate={~p"/chat"}
              class="flex w-full items-center justify-center gap-2 rounded-xl bg-brand px-7 py-3.5 text-[13.5px] font-semibold text-white shadow-lg shadow-brand/25 transition hover:bg-brand-600 sm:w-auto"
            >
              Open ViraChat <.icon name="hero-arrow-right" class="size-4" />
            </.link>
          <% else %>
            <.link
              navigate={~p"/users/register"}
              class="flex w-full items-center justify-center gap-2 rounded-xl bg-brand px-7 py-3.5 text-[13.5px] font-semibold text-white shadow-lg shadow-brand/25 transition hover:bg-brand-600 sm:w-auto"
            >
              Get started — it's free <.icon name="hero-arrow-right" class="size-4" />
            </.link>
            <.link
              navigate={~p"/users/log-in"}
              class="flex w-full items-center justify-center rounded-xl border border-line bg-white px-7 py-3.5 text-[13.5px] font-semibold text-ink transition hover:border-brand/30 hover:text-brand dark:border-[#2a2a2a] dark:bg-[#141414] dark:text-white sm:w-auto"
            >
              I have an account
            </.link>
          <% end %>
        </div>

        <p class="mt-4 text-[11.5px] text-muted">
          Free for personal use · No credit card required · Your data stays yours
        </p>

        <div class="relative mx-auto mt-12 max-w-5xl overflow-hidden rounded-3xl border border-line bg-white text-left shadow-2xl shadow-brand/10 dark:border-[#242424] dark:bg-[#101010]">
          <div class="flex h-[340px] sm:h-[380px]">
            <div class="hidden w-[58px] flex-shrink-0 flex-col items-center gap-2.5 border-r border-line bg-white py-4 dark:border-[#242424] dark:bg-[#0d0d0d] sm:flex">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand text-[11px] font-extrabold text-white">
                V
              </span>
              <span class="mt-2 flex h-8 w-8 items-center justify-center rounded-lg bg-brand-soft text-brand">
                <.icon name="hero-chat-bubble-left-right" class="size-4" />
              </span>
              <span class="flex h-8 w-8 items-center justify-center rounded-lg text-muted">
                <.icon name="hero-star" class="size-4" />
              </span>
              <span class="flex h-8 w-8 items-center justify-center rounded-lg text-muted">
                <.icon name="hero-user-group" class="size-4" />
              </span>
              <span class="flex h-8 w-8 items-center justify-center rounded-lg text-muted">
                <.icon name="hero-phone" class="size-4" />
              </span>
              <span class="mt-auto flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-brand to-[#8b5cf6] text-[10px] font-bold text-white">
                N
              </span>
            </div>

            <div class="hidden w-[210px] flex-shrink-0 flex-col border-r border-line bg-white dark:border-[#242424] dark:bg-[#0d0d0d] sm:flex">
              <p class="px-4 pb-2 pt-4 text-[15px] font-bold text-ink dark:text-white">Chats</p>
              <div class="mx-3 mb-3 flex items-center gap-2 rounded-lg bg-surface-2 px-3 py-2 text-[11px] text-muted dark:bg-[#161616]">
                <.icon name="hero-magnifying-glass" class="size-3.5" /> Search messages
              </div>
              <div class="mx-3 mb-3 flex gap-1.5">
                <span class="rounded-full bg-brand px-2.5 py-1 text-[10px] font-semibold text-white">
                  All
                </span>
                <span class="rounded-full border border-line px-2.5 py-1 text-[10px] font-semibold text-body dark:border-[#2a2a2a]">
                  Unread
                </span>
                <span class="rounded-full border border-line px-2.5 py-1 text-[10px] font-semibold text-body dark:border-[#2a2a2a]">
                  Groups
                </span>
              </div>
              <div class="space-y-1 px-2">
                <div class="flex items-center gap-2 rounded-lg bg-brand-soft px-2 py-2 dark:bg-[#1b1530]">
                  <span class="h-7 w-7 flex-shrink-0 rounded-full bg-gradient-to-br from-brand to-[#8b5cf6]"></span>
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-[11px] font-semibold text-ink dark:text-white">Ram</p>
                    <p class="truncate text-[10px] text-body">See you at 10!</p>
                  </div>
                  <span class="rounded-full bg-brand px-1.5 py-0.5 text-[9px] font-bold text-white">2</span>
                </div>
                <div class="flex items-center gap-2 rounded-lg px-2 py-2">
                  <span class="h-7 w-7 flex-shrink-0 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600"></span>
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-[11px] font-semibold text-ink dark:text-white">
                      Design team
                    </p>
                    <p class="truncate text-[10px] text-body">Mohan: shipped it 🎉</p>
                  </div>
                </div>
                <div class="flex items-center gap-2 rounded-lg px-2 py-2">
                  <span class="h-7 w-7 flex-shrink-0 rounded-full bg-gradient-to-br from-amber-500 to-orange-600"></span>
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-[11px] font-semibold text-ink dark:text-white">Vini</p>
                    <p class="truncate text-[10px] text-body">Sent a photo</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="flex min-w-0 flex-1 flex-col bg-[#FBFBFD] dark:bg-[#0b0b0d]">
              <div class="flex items-center gap-2.5 border-b border-line bg-white px-4 py-3 dark:border-[#242424] dark:bg-[#0d0d0d]">
                <span class="relative h-8 w-8 flex-shrink-0 rounded-full bg-gradient-to-br from-brand to-[#8b5cf6]">
                  <span class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full border-2 border-white bg-success dark:border-[#0d0d0d]">
                  </span>
                </span>
                <div class="min-w-0">
                  <p class="truncate text-[12px] font-bold text-ink dark:text-white">Ram</p>
                  <p class="text-[10px] text-success">Online</p>
                </div>
                <div class="ml-auto flex items-center gap-1 text-muted">
                  <.icon name="hero-phone" class="size-4" />
                  <.icon name="hero-video-camera" class="ml-1.5 size-4" />
                  <.icon name="hero-information-circle" class="ml-1.5 size-4" />
                </div>
              </div>

              <div class="flex-1 space-y-3 px-4 py-4">
                <div class="flex items-end gap-2">
                  <span class="h-6 w-6 flex-shrink-0 rounded-full bg-gradient-to-br from-brand to-[#8b5cf6]"></span>
                  <div>
                    <p class="mb-1 text-[9.5px] font-semibold text-body">Ram · 09:58</p>
                    <div class="max-w-[220px] rounded-xl rounded-bl-md border border-line bg-white px-3 py-2 text-[11.5px] text-ink dark:border-[#2a2a2a] dark:bg-[#161616] dark:text-[#d8dfeb]">
                      Hey! Are we still on for tomorrow?
                    </div>
                  </div>
                </div>

                <div class="flex justify-end">
                  <div class="max-w-[220px]">
                    <p class="mb-1 text-right text-[9.5px] font-semibold text-body">
                      You · 09:59
                    </p>
                    <div class="rounded-xl rounded-br-md bg-brand px-3 py-2 text-[11.5px] text-white">
                      Yes — 10am works perfectly 👍
                    </div>
                  </div>
                </div>

                <div class="flex items-end gap-2">
                  <span class="h-6 w-6 flex-shrink-0 rounded-full bg-gradient-to-br from-brand to-[#8b5cf6]"></span>
                  <div>
                    <p class="mb-1 text-[9.5px] font-semibold text-body">Ram · 10:00</p>
                    <div class="max-w-[220px] rounded-xl rounded-bl-md border border-line bg-white px-3 py-2 text-[11.5px] text-ink dark:border-[#2a2a2a] dark:bg-[#161616] dark:text-[#d8dfeb]">
                      Perfect. See you then!
                    </div>
                  </div>
                </div>
              </div>

              <div class="border-t border-line bg-white p-2.5 dark:border-[#242424] dark:bg-[#0d0d0d]">
                <div class="flex items-center gap-2 rounded-xl border border-line px-3 py-2 dark:border-[#2a2a2a]">
                  <span class="text-[10.5px] text-muted">Type a message…</span>
                  <span class="ml-auto flex h-6 w-6 items-center justify-center rounded-full bg-brand text-white">
                    <.icon name="hero-paper-airplane" class="size-3" />
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-6">
      <div class="mx-auto max-w-xl text-center">
        <h2 class="text-[28px] font-extrabold tracking-tight text-ink dark:text-white sm:text-[34px]">
          Everything you need to stay connected
        </h2>
        <p class="mt-3 text-[14px] leading-relaxed text-body">
          From one-to-one conversations to team group chats — ViraChat has the features modern
          messaging deserves.
        </p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <%= for {icon, title, body} <- [
          {"hero-bolt", "Real-time messaging", "Messages appear instantly across all devices. No refresh, no delay."},
          {"hero-user-group", "Group chats", "Bring your friends, family or team together in one conversation."},
          {"hero-signal", "Presence & typing", "See who's online and when someone is typing a reply."},
          {"hero-check-circle", "Read receipts", "Know exactly when your message has been delivered and seen."},
          {"hero-paper-clip", "File sharing", "Send images, voice notes and more with a single tap."},
          {"hero-shield-check", "Private by default", "Your conversations stay yours. No ads, no tracking."}
        ] do %>
          <div class="group rounded-2xl border border-line bg-white p-5 transition hover:border-brand/30 hover:shadow-lg hover:shadow-brand/5 dark:border-[#242424] dark:bg-[#141414]">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-soft text-brand transition group-hover:bg-brand group-hover:text-white dark:bg-[#1b1530] dark:group-hover:bg-brand">
              <.icon name={icon} class="size-5" />
            </div>
            <h3 class="mt-4 text-[14px] font-bold text-ink dark:text-white">{title}</h3>
            <p class="mt-1.5 text-[12.5px] leading-relaxed text-body">{body}</p>
          </div>
        <% end %>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-5 pb-20 sm:px-6">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand via-[#7c3aed] to-[#a855f7] px-6 py-12 text-center text-white sm:px-12">
        <div class="pointer-events-none absolute -right-20 -top-24 h-64 w-64 rounded-full bg-white/10 blur-2xl">
        </div>
        <div class="pointer-events-none absolute -bottom-24 -left-16 h-64 w-64 rounded-full bg-white/10 blur-2xl">
        </div>

        <h2 class="relative text-[26px] font-extrabold tracking-tight sm:text-[32px]">
          Ready to start chatting?
        </h2>
        <p class="relative mx-auto mt-3 max-w-md text-[13.5px] leading-relaxed text-white/80">
          Create your account in seconds. Free forever for personal use.
        </p>
        <div class="relative mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <%= if @current_scope && @current_scope.user do %>
            <.link
              navigate={~p"/chat"}
              class="flex w-full items-center justify-center gap-2 rounded-xl bg-white px-7 py-3 text-[13px] font-semibold text-brand transition hover:bg-white/90 sm:w-auto"
            >
              Open ViraChat <.icon name="hero-arrow-right" class="size-4" />
            </.link>
          <% else %>
            <.link
              navigate={~p"/users/register"}
              class="flex w-full items-center justify-center gap-2 rounded-xl bg-white px-7 py-3 text-[13px] font-semibold text-brand transition hover:bg-white/90 sm:w-auto"
            >
              Create your account <.icon name="hero-arrow-right" class="size-4" />
            </.link>
            <.link
              navigate={~p"/users/log-in"}
              class="rounded-xl border border-white/40 px-7 py-3 text-[13px] font-semibold text-white transition hover:bg-white/10"
            >
              Log in
            </.link>
          <% end %>
        </div>
      </div>
    </section>

    <footer class="border-t border-line dark:border-[#242424]">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 py-8 text-[12px] text-muted sm:flex-row sm:px-6">
        <div class="flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-brand text-[10px] font-extrabold text-white">
            V
          </span>
          <span class="font-semibold text-ink dark:text-white">ViraChat</span>
          <span>· Built with Elixir &amp; Phoenix</span>
        </div>
        <p>© {DateTime.utc_now().year} ViraChat. All rights reserved.</p>
      </div>
    </footer>
  </div>
</Layouts.app>
