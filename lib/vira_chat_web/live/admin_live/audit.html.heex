<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.admin_layout active={:audit} current_user={@current_user}>
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-[22px] font-bold text-ink dark:text-white">Audit log</h1>
        
        <p class="text-sm text-muted mt-1">Every admin action, most recent first</p>
      </div>
      
      <div class="flex items-center gap-3">
        <form phx-change="filter">
          <select
            name="action"
            class="text-sm px-3 py-2 border border-line dark:border-[#2a2a2a] rounded-lg focus:outline-none focus:ring-2 focus:ring-brand/30"
          >
            <option value="" selected={@action_filter == ""}>All actions</option>
            
            <%= for a <- @actions do %>
              <option value={a} selected={@action_filter == a}>
                {ViraChat.Admin.AdminAction.label(a)}
              </option>
            <% end %>
          </select>
        </form>
        
        <button
          phx-click="refresh"
          class="text-sm px-3 py-2 bg-surface-2 dark:bg-[#242424] hover:bg-line/70 rounded-lg text-ink dark:text-[#d8dfeb]"
        >
          ↻ Refresh
        </button>
      </div>
    </div>
    
    <div class="rounded-xl border border-line bg-white shadow-sm dark:border-[#242424] dark:bg-[#141414] overflow-hidden">
      <%= if @entries == [] do %>
        <div class="p-12 text-center text-muted">
          <p class="text-3xl mb-2">📭</p>
          
          <p>No audit entries yet</p>
        </div>
      <% else %>
        <table class="w-full text-sm">
          <thead class="bg-surface-2 dark:bg-[#161616] border-b border-line dark:border-[#242424] text-left text-xs uppercase text-muted">
            <tr>
              <th class="px-4 py-3">When</th>
              
              <th class="px-4 py-3">Actor</th>
              
              <th class="px-4 py-3">Action</th>
              
              <th class="px-4 py-3">Target</th>
              
              <th class="px-4 py-3">Details</th>
            </tr>
          </thead>
          
          <tbody class="divide-y divide-line dark:divide-[#242424]">
            <%= for entry <- @entries do %>
              <tr class="hover:bg-surface-2 dark:hover:bg-[#1c1c1c]">
                <td class="px-4 py-3 text-xs text-muted whitespace-nowrap">
                  {Calendar.strftime(entry.inserted_at, "%Y-%m-%d %H:%M:%S")}
                </td>
                
                <td class="px-4 py-3">
                  <%= if entry.actor do %>
                    <div class="text-sm font-medium text-ink dark:text-white">
                      {ViraChat.Accounts.User.display_name(entry.actor)}
                    </div>
                    
                    <div class="text-xs text-muted">{entry.actor.email}</div>
                  <% else %>
                    <span class="text-xs text-muted italic">(deleted)</span>
                  <% end %>
                </td>
                
                <td class="px-4 py-3">
                  <span class={"text-xs font-medium px-2 py-0.5 rounded #{action_badge_class(entry.action)}"}>
                    {ViraChat.Admin.AdminAction.label(entry.action)}
                  </span>
                </td>
                
                <td class="px-4 py-3">
                  <%= if entry.target_user do %>
                    <div class="text-sm text-ink dark:text-white">
                      {ViraChat.Accounts.User.display_name(entry.target_user)}
                    </div>
                    
                    <div class="text-xs text-muted">{entry.target_user.email}</div>
                  <% else %>
                    <span class="text-xs text-muted">—</span>
                  <% end %>
                </td>
                
                <td class="px-4 py-3 text-xs text-body">{format_details(entry.details)}</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </.admin_layout>
</Layouts.app>
