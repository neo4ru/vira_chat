<.admin_layout active={:users} current_user={@current_user}>
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Users</h1>
    <form phx-change="search" class="w-64">
      <input
        type="text"
        name="value"
        value={@search}
        placeholder="Search by email..."
        phx-debounce="300"
        class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </form>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200 text-left text-xs uppercase text-gray-500">
        <tr>
          <th class="px-4 py-3">User</th>
          <th class="px-4 py-3">Role</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3">Joined</th>
          <th class="px-4 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <%= for user <- @users do %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <%= if user.avatar_url do %>
                  <img src={user.avatar_url} class="w-8 h-8 rounded-full object-cover" />
                <% else %>
                  <div class="w-8 h-8 rounded-full bg-blue-500 text-white flex items-center justify-center text-xs font-bold">
                    <%= String.first(user.email) |> String.upcase() %>
                  </div>
                <% end %>
                <div>
                  <div class="font-medium text-gray-800">
                    <%= ViraChat.Accounts.User.display_name(user) %>
                  </div>
                  <div class="text-xs text-gray-500"><%= user.email %></div>
                </div>
              </div>
            </td>
            <td class="px-4 py-3">
              <%= if ViraChat.Accounts.User.superuser?(@current_user) do %>
                <form phx-change="change_role">
                  <input type="hidden" name="user_id" value={user.id} />
                  <select name="role" class="text-xs px-2 py-1 border border-gray-300 rounded">
                    <option value="user" selected={user.role == "user"}>User</option>
                    <option value="admin" selected={user.role == "admin"}>Admin</option>
                    <option value="superuser" selected={user.role == "superuser"}>
                      Superuser
                    </option>
                  </select>
                </form>
              <% else %>
                <span class="text-xs font-medium">
                  <%= ViraChat.Accounts.User.role_label(user) %>
                </span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <%= if ViraChat.Accounts.User.banned?(user) do %>
                <span class="text-xs font-medium text-red-600 bg-red-50 px-2 py-0.5 rounded">
                  Banned
                </span>
              <% else %>
                <span class="text-xs font-medium text-green-600 bg-green-50 px-2 py-0.5 rounded">
                  Active
                </span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-xs text-gray-500">
              <%= Calendar.strftime(user.inserted_at, "%Y-%m-%d") %>
            </td>
            <td class="px-4 py-3 text-right space-x-2">
              <%= if ViraChat.Accounts.User.banned?(user) do %>
                <button
                  phx-click="unban"
                  phx-value-id={user.id}
                  class="text-xs text-green-600 hover:underline"
                >
                  Unban
                </button>
              <% else %>
                <button
                  phx-click="ban"
                  phx-value-id={user.id}
                  class="text-xs text-yellow-600 hover:underline"
                >
                  Ban
                </button>
              <% end %>
              <button
                phx-click="delete"
                phx-value-id={user.id}
                data-confirm="Permanently delete this user and all their data?"
                class="text-xs text-red-600 hover:underline"
              >
                Delete
              </button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</.admin_layout>