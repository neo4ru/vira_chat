<.admin_layout active={:conversations} current_user={@current_user}>
  <h1 class="text-2xl font-bold text-gray-800 mb-6">Conversations</h1>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200 text-left text-xs uppercase text-gray-500">
        <tr>
          <th class="px-4 py-3">ID</th>
          <th class="px-4 py-3">Type</th>
          <th class="px-4 py-3">Participants</th>
          <th class="px-4 py-3">Messages</th>
          <th class="px-4 py-3">Updated</th>
          <th class="px-4 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <%= for c <- @conversations do %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-xs text-gray-500">#<%= c.id %></td>
            <td class="px-4 py-3">
              <span class={"text-xs font-medium px-2 py-0.5 rounded #{if c.type == "group", do: "bg-purple-100 text-purple-700", else: "bg-blue-100 text-blue-700"}"}>
                <%= c.type %>
              </span>
              <%= if c.title do %>
                <div class="text-xs text-gray-500 mt-1"><%= c.title %></div>
              <% end %>
            </td>
            <td class="px-4 py-3 text-xs text-gray-600">
              <%= Enum.map_join(c.users, ", ", & &1.email) %>
            </td>
            <td class="px-4 py-3 text-xs text-gray-600"><%= c.message_count %></td>
            <td class="px-4 py-3 text-xs text-gray-500">
              <%= Calendar.strftime(c.updated_at, "%Y-%m-%d %H:%M") %>
            </td>
            <td class="px-4 py-3 text-right">
              <button
                phx-click="delete"
                phx-value-id={c.id}
                data-confirm="Delete this conversation and all its messages?"
                class="text-xs text-red-600 hover:underline"
              >
                Delete
              </button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</.admin_layout>