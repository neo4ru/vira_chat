<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.admin_layout active={:conversations} current_user={@current_user}>
    <h1 class="text-[22px] font-bold text-ink dark:text-white mb-6">Conversations</h1>
    
    <div class="rounded-xl border border-line bg-white shadow-sm dark:border-[#242424] dark:bg-[#141414] overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-surface-2 dark:bg-[#161616] border-b border-line dark:border-[#242424] text-left text-xs uppercase text-muted">
          <tr>
            <th class="px-4 py-3">ID</th>
            
            <th class="px-4 py-3">Type</th>
            
            <th class="px-4 py-3">Participants</th>
            
            <th class="px-4 py-3">Messages</th>
            
            <th class="px-4 py-3">Updated</th>
            
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        
        <tbody class="divide-y divide-line dark:divide-[#242424]">
          <%= for c <- @conversations do %>
            <tr class="hover:bg-surface-2 dark:hover:bg-[#1c1c1c]">
              <td class="px-4 py-3 text-xs text-muted">#{c.id}</td>
              
              <td class="px-4 py-3">
                <span class={"text-xs font-medium px-2 py-0.5 rounded #{if c.type == "group", do: "bg-brand-soft text-brand", else: "bg-brand-soft text-brand"}"}>
                  {c.type}
                </span>
                <%= if c.title do %>
                  <div class="text-xs text-muted mt-1">{c.title}</div>
                <% end %>
              </td>
              
              <td class="px-4 py-3 text-xs text-body">
                {Enum.map_join(c.users, ", ", & &1.email)}
              </td>
              
              <td class="px-4 py-3 text-xs text-body">{c.message_count}</td>
              
              <td class="px-4 py-3 text-xs text-muted">
                {Calendar.strftime(c.updated_at, "%Y-%m-%d %H:%M")}
              </td>
              
              <td class="px-4 py-3 text-right">
                <button
                  phx-click="delete"
                  phx-value-id={c.id}
                  data-confirm="Delete this conversation and all its messages?"
                  class="text-xs text-danger hover:underline"
                >
                  Delete
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </.admin_layout>
</Layouts.app>
