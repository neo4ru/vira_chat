<.admin_layout active={:reports} current_user={@current_user}>
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-800">Reports</h1>
      <p class="text-sm text-gray-500 mt-1">User-submitted reports of messages and users</p>
    </div>
    <form phx-change="filter">
      <select name="status" class="text-sm px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="pending" selected={@filter == "pending"}>Pending</option>
        <option value="resolved" selected={@filter == "resolved"}>Resolved</option>
        <option value="dismissed" selected={@filter == "dismissed"}>Dismissed</option>
        <option value="" selected={@filter == ""}>All</option>
      </select>
    </form>
  </div>

  <%= if @reports == [] do %>
    <div class="bg-white rounded-lg shadow p-12 text-center text-gray-400">
      <p class="text-3xl mb-2">📭</p>
      <p>No reports in this view</p>
    </div>
  <% else %>
    <div class="space-y-4">
      <%= for report <- @reports do %>
        <div class="bg-white rounded-lg shadow border border-gray-100 overflow-hidden">
          <div class="p-4 border-b border-gray-100 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3 min-w-0">
              <span class={"text-xs font-semibold px-2 py-0.5 rounded-full #{case report.status do
                "pending" -> "bg-yellow-100 text-yellow-800"
                "resolved" -> "bg-green-100 text-green-800"
                "dismissed" -> "bg-gray-100 text-gray-600"
                _ -> "bg-gray-100 text-gray-600"
              end}"}>
                <%= ViraChat.Admin.Report.status_label(report.status) %>
              </span>
              <span class="text-xs font-medium text-red-700 bg-red-50 px-2 py-0.5 rounded-full">
                <%= ViraChat.Admin.Report.reason_label(report.reason) %>
              </span>
              <span class="text-xs text-gray-400 ml-2">
                <%= Calendar.strftime(report.inserted_at, "%Y-%m-%d %H:%M") %>
              </span>
            </div>
            <%= if report.status == "pending" do %>
              <div class="flex gap-2 flex-shrink-0">
                <button phx-click="dismiss" phx-value-id={report.id} class="text-xs px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg">Dismiss</button>
                <button phx-click="resolve" phx-value-id={report.id} class="text-xs px-3 py-1.5 bg-green-600 hover:bg-green-700 text-white rounded-lg">Resolve</button>
                <%= if report.reported_user && report.reported_user.id != @current_user.id do %>
                  <button
                    phx-click="ban_reported_user"
                    phx-value-id={report.id}
                    data-confirm={"Ban #{ViraChat.Accounts.User.display_name(report.reported_user)}?"}
                    class="text-xs px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded-lg"
                  >Ban user</button>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="p-4 grid grid-cols-2 gap-4 text-sm">
            <div>
              <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Reported by</div>
              <div class="flex items-center gap-2">
                <%= if report.reporter.avatar_url do %>
                  <img src={report.reporter.avatar_url} class="w-6 h-6 rounded-full object-cover" />
                <% else %>
                  <div class="w-6 h-6 rounded-full bg-blue-500 text-white flex items-center justify-center text-xs font-bold">
                    <%= String.first(report.reporter.email) |> String.upcase() %>
                  </div>
                <% end %>
                <span class="text-gray-800"><%= ViraChat.Accounts.User.display_name(report.reporter) %></span>
              </div>
            </div>

            <div>
              <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Reported user</div>
              <%= if report.reported_user do %>
                <div class="flex items-center gap-2">
                  <%= if report.reported_user.avatar_url do %>
                    <img src={report.reported_user.avatar_url} class="w-6 h-6 rounded-full object-cover" />
                  <% else %>
                    <div class="w-6 h-6 rounded-full bg-red-500 text-white flex items-center justify-center text-xs font-bold">
                      <%= String.first(report.reported_user.email) |> String.upcase() %>
                    </div>
                  <% end %>
                  <span class="text-gray-800"><%= ViraChat.Accounts.User.display_name(report.reported_user) %></span>
                </div>
              <% else %>
                <span class="text-gray-400 italic">—</span>
              <% end %>
            </div>
          </div>

          <%= if report.message do %>
            <div class="px-4 pb-4">
              <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Message</div>
              <div class="bg-gray-50 rounded-lg p-3 text-sm text-gray-700">
                <%= if report.message.deleted_at do %>
                  <em class="text-gray-400">This message was deleted</em>
                <% else %>
                  <%= report.message.content || "(attachment)" %>
                <% end %>
              </div>
            </div>
          <% end %>

          <%= if report.details && report.details != "" do %>
            <div class="px-4 pb-4">
              <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Reporter's note</div>
              <div class="text-sm text-gray-700 italic">"<%= report.details %>"</div>
            </div>
          <% end %>

          <%= if report.resolved_at do %>
            <div class="px-4 py-2 bg-gray-50 border-t border-gray-100 text-xs text-gray-500">
              Resolved by <%= report.resolved_by && ViraChat.Accounts.User.display_name(report.resolved_by) %>
              · <%= Calendar.strftime(report.resolved_at, "%Y-%m-%d %H:%M") %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</.admin_layout>