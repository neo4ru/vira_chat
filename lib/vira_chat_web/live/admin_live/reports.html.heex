<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.admin_layout active={:reports} current_user={@current_user}>
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-[22px] font-bold text-ink dark:text-white">Reports</h1>
        
        <p class="text-sm text-muted mt-1">User-submitted reports of messages and users</p>
      </div>
      
      <form phx-change="filter">
        <select
          name="status"
          class="text-sm px-3 py-2 border border-line dark:border-[#2a2a2a] rounded-lg focus:outline-none focus:ring-2 focus:ring-brand/30"
        >
          <option value="pending" selected={@filter == "pending"}>Pending</option>
          
          <option value="resolved" selected={@filter == "resolved"}>Resolved</option>
          
          <option value="dismissed" selected={@filter == "dismissed"}>Dismissed</option>
          
          <option value="" selected={@filter == ""}>All</option>
        </select>
      </form>
    </div>
    
    <%= if @reports == [] do %>
      <div class="rounded-xl border border-line bg-white shadow-sm dark:border-[#242424] dark:bg-[#141414] p-12 text-center text-muted">
        <p class="text-3xl mb-2">📭</p>
        
        <p>No reports in this view</p>
      </div>
    <% else %>
      <div class="space-y-4">
        <%= for report <- @reports do %>
          <div class="rounded-xl border border-line bg-white shadow-sm dark:border-[#242424] dark:bg-[#141414] border border-line dark:border-[#242424] overflow-hidden">
            <div class="p-4 border-b border-line dark:border-[#242424] flex items-center justify-between gap-4">
              <div class="flex items-center gap-3 min-w-0">
                <span class={"text-xs font-semibold px-2 py-0.5 rounded-full #{case report.status do
                "pending" -> "bg-warning/10 text-warning"
                "resolved" -> "bg-success/10 text-success"
                "dismissed" -> "bg-surface-2 dark:bg-[#242424] text-body"
                _ -> "bg-surface-2 dark:bg-[#242424] text-body"
              end}"}>
                  {ViraChat.Admin.Report.status_label(report.status)}
                </span>
                <span class="text-xs font-medium text-danger bg-danger/10 px-2 py-0.5 rounded-full">
                  {ViraChat.Admin.Report.reason_label(report.reason)}
                </span>
                <span class="text-xs text-muted ml-2">
                  {Calendar.strftime(report.inserted_at, "%Y-%m-%d %H:%M")}
                </span>
              </div>
              
              <%= if report.status == "pending" do %>
                <div class="flex gap-2 flex-shrink-0">
                  <button
                    phx-click="dismiss"
                    phx-value-id={report.id}
                    class="text-xs px-3 py-1.5 bg-surface-2 dark:bg-[#242424] hover:bg-line/70 text-ink dark:text-[#d8dfeb] rounded-lg"
                  >
                    Dismiss
                  </button>
                  <button
                    phx-click="resolve"
                    phx-value-id={report.id}
                    class="text-xs px-3 py-1.5 bg-success hover:bg-success/90 text-white rounded-lg"
                  >
                    Resolve
                  </button>
                  <%= if report.reported_user && report.reported_user.id != @current_user.id do %>
                    <button
                      phx-click="ban_reported_user"
                      phx-value-id={report.id}
                      data-confirm={"Ban #{ViraChat.Accounts.User.display_name(report.reported_user)}?"}
                      class="text-xs px-3 py-1.5 bg-danger hover:bg-danger/90 text-white rounded-lg"
                    >
                      Ban user
                    </button>
                  <% end %>
                </div>
              <% end %>
            </div>
            
            <div class="p-4 grid grid-cols-2 gap-4 text-sm">
              <div>
                <div class="text-xs font-semibold text-muted uppercase tracking-wide mb-1">
                  Reported by
                </div>
                
                <div class="flex items-center gap-2">
                  <%= if report.reporter.avatar_url do %>
                    <img
                      src={report.reporter.avatar_url}
                      class="w-6 h-6 rounded-full object-cover"
                    />
                  <% else %>
                    <div class="w-6 h-6 rounded-full bg-brand text-white flex items-center justify-center text-xs font-bold">
                      {String.first(report.reporter.email) |> String.upcase()}
                    </div>
                  <% end %>
                  
                  <span class="text-ink dark:text-white">
                    {ViraChat.Accounts.User.display_name(report.reporter)}
                  </span>
                </div>
              </div>
              
              <div>
                <div class="text-xs font-semibold text-muted uppercase tracking-wide mb-1">
                  Reported user
                </div>
                
                <%= if report.reported_user do %>
                  <div class="flex items-center gap-2">
                    <%= if report.reported_user.avatar_url do %>
                      <img
                        src={report.reported_user.avatar_url}
                        class="w-6 h-6 rounded-full object-cover"
                      />
                    <% else %>
                      <div class="w-6 h-6 rounded-full bg-danger/100 text-white flex items-center justify-center text-xs font-bold">
                        {String.first(report.reported_user.email) |> String.upcase()}
                      </div>
                    <% end %>
                    
                    <span class="text-ink dark:text-white">
                      {ViraChat.Accounts.User.display_name(report.reported_user)}
                    </span>
                  </div>
                <% else %>
                  <span class="text-muted italic">—</span>
                <% end %>
              </div>
            </div>
            
            <%= if report.message do %>
              <div class="px-4 pb-4">
                <div class="text-xs font-semibold text-muted uppercase tracking-wide mb-1">
                  Message
                </div>
                
                <div class="bg-surface-2 dark:bg-[#161616] rounded-lg p-3 text-sm text-ink dark:text-[#d8dfeb]">
                  <%= if report.message.deleted_at do %>
                    <em class="text-muted">This message was deleted</em>
                  <% else %>
                    {report.message.content || "(attachment)"}
                  <% end %>
                </div>
              </div>
            <% end %>
            
            <%= if report.details && report.details != "" do %>
              <div class="px-4 pb-4">
                <div class="text-xs font-semibold text-muted uppercase tracking-wide mb-1">
                  Reporter's note
                </div>
                
                <div class="text-sm text-ink dark:text-[#d8dfeb] italic">"{report.details}"</div>
              </div>
            <% end %>
            
            <%= if report.resolved_at do %>
              <div class="px-4 py-2 bg-surface-2 dark:bg-[#161616] border-t border-line dark:border-[#242424] text-xs text-muted">
                Resolved by {report.resolved_by &&
                  ViraChat.Accounts.User.display_name(report.resolved_by)} · {Calendar.strftime(
                  report.resolved_at,
                  "%Y-%m-%d %H:%M"
                )}
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </.admin_layout>
</Layouts.app>
