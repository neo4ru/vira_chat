<div class="min-h-screen bg-slate-50 dark:bg-slate-950">
  <div class="max-w-2xl mx-auto">
    <!-- Banner -->
    <div class="h-40 bg-gradient-to-br from-indigo-500 via-violet-500 to-purple-600 relative"></div>

    <!-- Avatar + name -->
    <div class="px-6 pb-6 -mt-16 relative">
      <div class="flex items-end gap-4 mb-6">
        <%= if @current_user.avatar_url do %>
          <img src={@current_user.avatar_url} class="w-28 h-28 rounded-full object-cover border-4 border-slate-50 dark:border-slate-950 shadow-lg" />
        <% else %>
          <div class="w-28 h-28 rounded-full bg-gradient-to-br from-indigo-500 to-blue-600 flex items-center justify-center text-white text-4xl font-bold border-4 border-slate-50 dark:border-slate-950 shadow-lg">
            <%= String.first(@current_user.email) |> String.upcase() %>
          </div>
        <% end %>

        <div class="flex-1 min-w-0 pb-3">
          <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100 truncate">
            <%= ViraChat.Accounts.User.display_name(@current_user) %>
          </h1>
          <p class="text-sm text-slate-500 dark:text-slate-400 truncate"><%= @current_user.email %></p>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="flex gap-2 mb-6">
        <button
          phx-click="toggle_edit"
          class="flex-1 px-4 py-2.5 bg-indigo-600 text-white rounded-xl font-medium hover:bg-indigo-700 transition"
        >
          <%= if @editing, do: "Close editor", else: "Edit profile" %>
        </button>
        <.link
          navigate={~p"/chat"}
          class="px-4 py-2.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 rounded-xl font-medium hover:bg-slate-200 dark:hover:bg-slate-700 transition"
        >
          Back to chat
        </.link>
      </div>

      <!-- Bio (read-only view) -->
      <%= if !@editing do %>
        <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 mb-4">
          <div class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-3">About</div>
          <%= if @current_user.bio && @current_user.bio != "" do %>
            <p class="text-slate-700 dark:text-slate-200 leading-relaxed whitespace-pre-wrap"><%= @current_user.bio %></p>
          <% else %>
            <p class="text-slate-400 dark:text-slate-500 italic">No bio yet. Click "Edit profile" to add one.</p>
          <% end %>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 text-center">
            <div class="text-3xl font-bold text-indigo-600 dark:text-indigo-400"><%= @stats.conversations %></div>
            <div class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-1">Conversations</div>
          </div>
          <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 text-center">
            <div class="text-3xl font-bold text-indigo-600 dark:text-indigo-400"><%= @stats.messages %></div>
            <div class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-1">Messages sent</div>
          </div>
        </div>

        <!-- Danger zone -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6">
          <div class="text-xs font-semibold text-red-600 dark:text-red-400 uppercase tracking-wider mb-3">Account</div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-slate-600 dark:text-slate-400">Log out of this device</span>
            <.link
              href={~p"/users/log-out"}
              method="delete"
              class="text-sm text-red-600 dark:text-red-400 hover:underline font-medium"
            >
              Log out →
            </.link>
          </div>
        </div>
      <% else %>
        <!-- Edit form -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 mb-4">
          <.form for={@form} phx-change="validate" phx-submit="save_profile" class="space-y-6">
            <!-- Avatar upload -->
            <div>
              <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-3">Profile picture</label>
              <div class="flex items-center gap-4">
                <%= if @current_user.avatar_url do %>
                  <img src={@current_user.avatar_url} class="w-16 h-16 rounded-full object-cover" />
                <% else %>
                  <div class="w-16 h-16 rounded-full bg-indigo-500 flex items-center justify-center text-white text-xl font-bold">
                    <%= String.first(@current_user.email) |> String.upcase() %>
                  </div>
                <% end %>
                <label class="cursor-pointer text-sm text-indigo-600 dark:text-indigo-400 hover:underline">
                  Upload new photo
                  <.live_file_input upload={@uploads.avatar} class="hidden" />
                </label>
              </div>

              <%= for entry <- @uploads.avatar.entries do %>
                <div class="mt-3 flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400 bg-slate-50 dark:bg-slate-800 px-3 py-2 rounded-lg">
                  <span><%= entry.client_name %></span>
                  <button type="button" phx-click="cancel-upload" phx-value-ref={entry.ref} phx-value-key="avatar" class="text-red-500 ml-auto">✕</button>
                </div>
              <% end %>
            </div>

            <!-- Display name -->
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1.5">Display name</label>
              <input
                type="text"
                name="display_name"
                value={@form[:display_name].value}
                placeholder="e.g. Vini"
                maxlength="50"
                class="w-full px-4 py-2.5 border border-slate-300 dark:border-slate-700 rounded-xl bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
              />
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">If empty, your email is shown instead.</p>
            </div>

            <!-- Bio -->
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1.5">Bio</label>
              <textarea
                name="bio"
                rows="3"
                maxlength="200"
                placeholder="A short description about you"
                class="w-full px-4 py-2.5 border border-slate-300 dark:border-slate-700 rounded-xl bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
              ><%= @form[:bio].value %></textarea>
            </div>

            <!-- Email (read-only) -->
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1.5">Email</label>
              <input
                type="text"
                value={@current_user.email}
                disabled
                class="w-full px-4 py-2.5 border border-slate-200 dark:border-slate-700 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-500"
              />
            </div>

            <div class="flex justify-end gap-2 pt-2">
              <button
                type="button"
                phx-click="toggle_edit"
                class="px-5 py-2.5 text-sm text-slate-600 dark:text-slate-400 hover:underline"
              >
                Cancel
              </button>
              <button
                type="submit"
                class="px-6 py-2.5 bg-indigo-600 text-white rounded-xl font-medium hover:bg-indigo-700 transition"
              >
                Save profile
              </button>
            </div>
          </.form>
        </div>
      <% end %>
    </div>
  </div>
</div>