<div class="min-h-screen bg-slate-50 dark:bg-slate-950">
  <header class="border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 sticky top-0 z-10">
    <div class="max-w-3xl mx-auto px-4 py-4 flex items-center gap-3">
      <.link navigate={~p"/chat"} class="w-9 h-9 flex items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition">←</.link>
      <div class="flex items-center gap-2">
        <span class="text-2xl">⭐</span>
        <h1 class="text-xl font-bold text-slate-800 dark:text-slate-100">Starred messages</h1>
      </div>
      <span class="text-sm text-slate-500 dark:text-slate-400 ml-auto"><%= length(@messages) %></span>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 py-6">
    <%= if @messages == [] do %>
      <div class="text-center py-20 text-slate-400 dark:text-slate-600">
        <div class="w-16 h-16 mx-auto mb-4 rounded-3xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center text-white text-3xl shadow-lg shadow-amber-500/20">⭐</div>
        <p class="text-lg font-medium text-slate-600 dark:text-slate-300">No starred messages yet</p>
        <p class="text-sm mt-1">Hover any message in a chat and click ⭐ to save it here.</p>
      </div>
    <% else %>
      <div class="space-y-3">
        <%= for message <- @messages do %>
          <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-4 hover:shadow-md transition group">
            <div class="flex items-start gap-3 mb-3">
              <%= if message.user.avatar_url do %>
                <img src={message.user.avatar_url} class="w-9 h-9 rounded-full object-cover flex-shrink-0" />
              <% else %>
                <div class={"w-9 h-9 rounded-full bg-gradient-to-br flex items-center justify-center text-white text-xs font-bold flex-shrink-0 #{ViraChat.Accounts.User.avatar_gradient(message.user)}"}>
                  <%= String.first(message.user.email) |> String.upcase() %>
                </div>
              <% end %>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-semibold text-slate-800 dark:text-slate-100">
                  <%= ViraChat.Accounts.User.display_name(message.user) %>
                </div>
                <div class="text-xs text-slate-500 dark:text-slate-400">
                  in <span class="font-medium"><%= conversation_title(message.conversation, @current_user) %></span>
                  · <%= time_ago(message.inserted_at) %>
                </div>
              </div>
              <div class="flex gap-1 opacity-0 group-hover:opacity-100 transition">
                <button
                  type="button"
                  phx-click="open_conversation"
                  phx-value-id={message.conversation_id}
                  title="Go to chat"
                  class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 text-sm"
                >↗</button>
                <button
                  type="button"
                  phx-click="unstar"
                  phx-value-id={message.id}
                  title="Unstar"
                  class="w-8 h-8 flex items-center justify-center rounded-lg text-amber-500 hover:bg-amber-50 dark:hover:bg-amber-900/20 text-sm"
                >⭐</button>
              </div>
            </div>

            <div class="pl-12">
              <%= if message.content && message.content != "" do %>
                <div class="text-slate-700 dark:text-slate-200 whitespace-pre-wrap break-words leading-relaxed">
                  <%= message.content %>
                </div>
              <% end %>

              <%= if message.media_url do %>
                <div class="mt-2">
                  <div class="text-xs text-slate-500 dark:text-slate-400 italic">📎 Attachment (open chat to view)</div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </main>
</div>